generator client {
    provider = "prisma-client"
    output   = "./generated"
}

datasource db {
    provider = "postgresql"
}

model Product {
    id          String     @id @default(cuid())
    name        String
    description String?
    price       Decimal    @db.Money
    stock       Int        @default(0)
    lowStock    Int?
    imageUrl    String?
    active      Boolean    @default(true)
    createdAt   DateTime   @default(now())
    updatedAt   DateTime   @updatedAt

    userId      String     @db.Uuid

    categories  Category[]

    @@index([userId, name])
    @@index([createdAt])
}

model Category {
    id       String    @id @default(cuid())
    name     String
    slug     String    @unique
    products Product[]
}